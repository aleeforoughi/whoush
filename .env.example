# All real provider calls and checkout disabled in this scaffold.
NEXT_PUBLIC_APP_NAME=Whoush
DEMO_FX_TOMAN_PER_USD=250000
NEURON_RETAIL_USD_MICROS=176000
FX_SOURCE=demo
ALLOW_LIVE_GENERATION=false
PROVIDER_END_USER_AUTHORIZED=false
PROVIDER_RESELLER_AUTHORIZED=false
HIGGSFIELD_API_KEY=
# Live submission needs ALL of: the four flags above/below, a verified model, a valid signed quote (see generationGate in lib/policy.ts).
PRODUCTION_MODERATION_VERIFIED=false
BILLING_LEDGER_VERIFIED=false
# >= 32 chars. Required for live quotes; demo mode falls back to a random per-process secret.
QUOTE_SIGNING_SECRET=
HIGGSFIELD_API_BASE=https://api.higgsfield.ai
ANTHROPIC_API_KEY=
# Live private LLM planning requires BOTH flags true plus a configured model id and key (see llmPolicy in lib/llm.ts).
LLM_PROVIDER_AUTHORIZED=false
ALLOW_LIVE_LLM=false
OPENAI_API_KEY=
# Model IDs and providers must be verified against current API docs before enabling. The provider is chosen privately by the id prefix:
# claude-* uses ANTHROPIC_API_KEY, gpt-* (for example gpt-6.1-sol) uses OPENAI_API_KEY, any other id never goes live. Routing stays private; see docs/LLM_ROUTING.md.
# Optional legacy overrides: each replaces the FIRST rung of the quick, standard or complex ladder in config/llm-routing.json. Leave blank to use the configured ladders.
LLM_FAST_MODEL=
LLM_BALANCED_MODEL=
LLM_DEEP_MODEL=
DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_BUCKET=

# Owner-only local testing against the real providers (lib/policy.ts devLiveTest). Works only under `npm run dev`
# (NODE_ENV=development), never in a production build, and asserts no launch authorization: the flags above stay false.
# Never charges Neurons; only verified model paths (today Soul Standard) are callable; real media submissions are
# capped per server process. Put real keys only in .env.local (git-ignored), never here.
WHOUSH_DEV_LIVE_TEST=false
WHOUSH_DEV_LIVE_MAX_SUBMITS=5
