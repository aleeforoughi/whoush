# All real provider calls and checkout disabled in this scaffold.
NEXT_PUBLIC_APP_NAME=Whoush
DEMO_FX_TOMAN_PER_USD=250000
NEURON_RETAIL_USD_MICROS=176000
FX_SOURCE=demo
ALLOW_LIVE_GENERATION=false
PROVIDER_END_USER_AUTHORIZED=false
PROVIDER_RESELLER_AUTHORIZED=false
HIGGSFIELD_API_KEY=
# Live submission needs ALL of: the four flags above/below, a verified model, a valid signed quote (see generationGate in lib/policy.ts).
PRODUCTION_MODERATION_VERIFIED=false
BILLING_LEDGER_VERIFIED=false
# >= 32 chars. Required for live quotes; demo mode falls back to a random per-process secret.
QUOTE_SIGNING_SECRET=
HIGGSFIELD_API_BASE=https://api.higgsfield.ai
ANTHROPIC_API_KEY=
# Live private LLM planning requires BOTH flags true plus a configured model id and key (see llmPolicy in lib/llm.ts).
LLM_PROVIDER_AUTHORIZED=false
ALLOW_LIVE_LLM=false
OPENAI_API_KEY=
# Model IDs and providers must be verified against current API docs before enabling.
LLM_FAST_MODEL=
LLM_BALANCED_MODEL=
LLM_DEEP_MODEL=
DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_BUCKET=
